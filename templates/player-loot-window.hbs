<section class="lootforge-wow-body">
  <header class="lootforge-wow-header">
    <div class="lootforge-wow-ornament" aria-hidden="true">
      <img src="{{bagIcon}}" alt="" />
    </div>
    <h2 class="lootforge-wow-title">{{localize "LOOTFORGE.Player.WindowTitle"}}</h2>
    <p class="lootforge-wow-subtitle">{{creature.name}}</p>
  </header>

  {{#if empty}}
  <p class="lootforge-wow-empty">{{localize "LOOTFORGE.Notify.CorpseEmpty"}}</p>
  {{else}}
  <p class="lootforge-wow-hint">{{hint}}</p>
  <ul class="lootforge-wow-list">
    {{#each items}}
    <li class="lootforge-wow-row {{rarityClass}}" data-entry-id="{{entryId}}" data-tooltip="{{description}}">
      <div class="lootforge-wow-icon">
        <img src="{{img}}" alt="" />
        {{#if qtyLabel}}<span class="lootforge-wow-qty">{{qtyLabel}}</span>{{/if}}
      </div>
      <span class="lootforge-wow-name">{{name}}</span>
    </li>
    {{/each}}
  </ul>
  {{/if}}

  <footer class="lootforge-wow-footer">
    {{#unless empty}}
    <button type="button" class="lootforge-wow-btn lootforge-wow-btn-lootall" data-action="takeAll" {{#if busy}}disabled{{/if}}>
      {{localize "LOOTFORGE.Player.LootAll"}}
    </button>
    {{/unless}}
    <button type="button" class="lootforge-wow-btn lootforge-wow-btn-done" data-action="doneLoot" {{#if busy}}disabled{{/if}}>
      {{localize "LOOTFORGE.Player.Done"}}
    </button>
  </footer>
</section>
