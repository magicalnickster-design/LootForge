<div class="lootforge-loot-dialog">
  <header class="lootforge-loot-dialog__header">
    <h3>{{creatureName}}</h3>
    <p class="lootforge-loot-dialog__meta">{{interactionLabel}} &middot; {{skillLabel}}</p>
  </header>

  <dl class="lootforge-loot-dialog__stats">
    <div>
      <dt>{{localize "LOOTFORGE.Dialog.RollTotal"}}</dt>
      <dd>{{rollTotal}}</dd>
    </div>
    <div>
      <dt>{{localize "LOOTFORGE.Dialog.NaturalDie"}}</dt>
      <dd>{{natural}}</dd>
    </div>
    <div>
      <dt>{{localize "LOOTFORGE.Dialog.Tier"}}</dt>
      <dd>{{tierLabel}}</dd>
    </div>
  </dl>

  {{#if isNatural20}}
  <p class="lootforge-loot-dialog__bonus">{{localize "LOOTFORGE.Dialog.BonusItem"}}</p>
  {{/if}}

  <section class="lootforge-loot-dialog__items">
    <h4>{{localize "LOOTFORGE.Dialog.Items"}}</h4>
    {{#if empty}}
    <p class="lootforge-loot-dialog__empty">{{localize "LOOTFORGE.Dialog.Empty"}}</p>
    {{else}}
    <ul>
      {{#each items}}
      <li class="{{#if bonus}}is-bonus{{/if}}">
        <span class="item-name">{{name}}</span>
        <span class="item-qty">× {{quantity}}</span>
      </li>
      {{/each}}
    </ul>
    {{/if}}
  </section>
</div>
