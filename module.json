{
  "id": "lootforge",
  "title": "LootForge",
  "description": "Interactive looting and harvesting for defeated creatures. Built for Gambits Forge.",
  "version": "0.4.1",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    {
      "name": "Gambits Forge",
      "flags": {}
    }
  ],
  "relationships": {
    "systems": [
      {
        "id": "dnd5e",
        "type": "system",
        "compatibility": {
          "minimum": "4.0.0",
          "verified": "5.3.3"
        }
      }
    ]
  },
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/lootforge.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [
    {
      "name": "loot-items",
      "label": "LootForge Items",
      "path": "packs/loot-items",
      "type": "Item",
      "system": "dnd5e",
      "ownership": {
        "PLAYER": "OBSERVER",
        "ASSISTANT": "OWNER"
      }
    }
  ],
  "packFolders": [
    {
      "name": "LootForge",
      "sorting": "a",
      "packs": ["loot-items"]
    }
  ],
  "socket": true,
  "url": "https://github.com/magicalnickster-design/LootForge",
  "readme": "README.md",
  "bugs": "https://github.com/magicalnickster-design/LootForge/issues",
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["styles", "templates", "lang", "packs/src"]
    }
  }
}
